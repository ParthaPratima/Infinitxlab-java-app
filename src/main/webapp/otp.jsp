<!DOCTYPE html>
<html>
<head>
<title>Verify OTP</title>
</head>

<body style="font-family:Arial;background:#071739;color:white;">

<center>

<h2>Verify OTP</h2>

<form action="resetpassword" method="post">

<input type="text"
       name="otp"
       placeholder="Enter OTP"
       required><br><br>

<input type="password"
       name="password"
       placeholder="New Password"
       required><br><br>

<button type="submit">
Reset Password
</button>

</form>

</center>

</body>
</html>
